# API Configuration
VITE_API_BASE_URL=/jsonapi/
VITE_SITE_BASE_URL=https://promptual.puntuale.nl

# Cache Configuration
VITE_CACHE_TTL_MS=1800000

# Pagination Limits
VITE_ARTICLE_PAGE_LIMIT=30
VITE_TAG_PAGE_LIMIT=100
VITE_MAX_ARTICLES=2000
VITE_MAX_SEARCH_ARTICLES=300

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_FAVORITES=true
VITE_ENABLE_FULLSCREEN_VIEWER=true
